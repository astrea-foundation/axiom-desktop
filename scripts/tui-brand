#!/usr/bin/env python3
"""Derive terminal Braille artwork from the desktop's eagle-and-globe SVG.

Requires rsvg-convert and Pillow. Run from the repository root.
"""
from io import BytesIO
from pathlib import Path
import subprocess

from PIL import Image

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "apps/desktop/src/renderer/src/brand/axiom-symbol-logo-colored.svg"
TARGET = ROOT / "apps/axiomcli/src/tui/brand.rs"
DOTS = ((0, 0, 0), (0, 1, 1), (0, 2, 2), (1, 0, 3), (1, 1, 4), (1, 2, 5), (0, 3, 6), (1, 3, 7))


def artwork(columns, rows):
    data = subprocess.check_output([
        "rsvg-convert", "--width", str(columns * 2), "--height", str(rows * 4),
        "--keep-aspect-ratio", str(SOURCE),
    ])
    source = Image.open(BytesIO(data)).convert("RGBA")
    mask = Image.new("L", (columns * 2, rows * 4))
    mask.paste(source.getchannel("A"), (0, 0))
    return ["".join(
        chr(0x2800 + sum(1 << bit for dx, dy, bit in DOTS if mask.getpixel((x * 2 + dx, y * 4 + dy)) >= 100))
        for x in range(columns)
    ).replace("\u2800", " ").rstrip() for y in range(rows)]


lines = ["// Generated by scripts/tui-brand from the desktop eagle-and-globe mark."]
for name, columns, rows in [("EAGLE", 32, 11), ("COMPACT_EAGLE", 22, 8)]:
    lines += [f"pub(super) const {name}: [&str; {rows}] = ["]
    lines += [f'    "{line}",' for line in artwork(columns, rows)]
    lines += ["];", ""]
TARGET.write_text("\n".join(lines))
