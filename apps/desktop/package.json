{
  "name": "axiom-desktop",
  "productName": "Axiom",
  "desktopName": "stream.axiom.desktop.desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Axiom private desktop chat driven by AxiomCLI over ACP",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ./scripts/ensure-electron.mjs && node ./scripts/run-electron.mjs vite dev",
    "install:desktop": "node ./scripts/install-linux-desktop-entry.mjs",
    "build": "electron-vite build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "node ./scripts/ensure-electron.mjs && node ./scripts/run-electron.mjs vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "capture": "node ./scripts/ensure-electron.mjs && node ./scripts/run-electron.mjs vite build && node ./scripts/run-electron.mjs electron . --capture"
  },
  "dependencies": {
    "@axiom/axiom-acp-client": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "~5.1.4",
    "electron": "^37.2.6",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
