{
  "name": "axiom-desktop",
  "productName": "Axiom",
  "version": "0.0.0",
  "private": true,
  "description": "Axiom desktop visual concept",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ./scripts/ensure-electron.mjs && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "capture": "node ./scripts/ensure-electron.mjs && electron-vite build && env -u ELECTRON_RUN_AS_NODE electron . --capture"
  },
  "dependencies": {
    "@axiom/axiom-acp-client": "workspace:*",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@dnd-kit/core": "^6.3.1",
    "animejs": "^4.5.0",
    "lucide-react": "^0.564.0",
    "ogl": "^1.0.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "~5.1.4",
    "electron": "^37.2.6",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
