{
  "name": "@axiom/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "cloudflare:dry-run": "npm run build && wrangler deploy --env= --dry-run",
    "cloudflare:dry-run:staging": "npm run build && wrangler deploy --env staging --dry-run",
    "deploy:production": "npm run build && wrangler deploy --env=",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "review": "vite --config vite.review.config.ts --host 127.0.0.1",
    "build:review": "vite build --config vite.review.config.ts",
    "test:browser": "node scripts/review-check.mjs",
    "capture": "node scripts/capture-pages.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "@axiom/brand": "workspace:*",
    "@axiom/ui": "workspace:*",
    "lucide-react": "^0.564.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "~6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.9",
    "wrangler": "4.129.0",
    "playwright": "1.61.1"
  }
}
